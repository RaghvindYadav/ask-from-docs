# Embeddings: 'google' (Gemini, free tier available) or 'openai'
EMBEDDING_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/askdocs

# Optional: only ingest the first N docs files per version (quick test run)
# INGEST_LIMIT=20
# Optional: tokens/minute cap for embedding calls (default 28000 for google, off for openai; 0 = off)
# EMBED_TPM=28000

# Week 3+
COHERE_API_KEY=

# Week 4+
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
