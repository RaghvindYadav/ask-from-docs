{
  "name": "ask-the-docs",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:init": "tsx scripts/db-init.ts",
    "db:stats": "tsx scripts/db-stats.ts",
    "docs:fetch": "bash scripts/fetch-docs.sh",
    "ingest": "npm run start -w @askdocs/ingest",
    "test": "npm run test -w @askdocs/ingest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "postgres": "^3.4.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
